# 支付相关配置，合并到现有 .env；保留原数据库、登录配置。
APPID=
MCH_ID=
SERIALNO=
PAY_URL=https://api.mch.weixin.qq.com/v3/pay/transactions/jsapi
# 例如 https://你的API域名/api/notify；必须为公网 HTTPS。
NOTIFY_URL=
# 保留现有整单退款能力时配置 https://你的API域名/api/notify/wxRefund。
REFUND_NOTIFY_URL=
API_V3_KEY=
WECHATPAY_PUBLIC_KEY_ID=
# 微信支付公钥 PEM，允许使用字面量 \n 表示换行，不填写商户私钥。
WECHATPAY_PUBLIC_KEY=
# 商户私钥由使用者亲自填写 src/utils/wechat-pay.ts 的 getPrivateKey()。
