generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// 平台账号使用 SUPER_ADMIN / PLATFORM_ADMIN；旧门店账号保留兼容，新店长通过 User 手机号关联门店。

// 后台管理员角色
enum adminRole {
  SUPER_ADMIN // 超级管理员
  PLATFORM_ADMIN // 平台管理员
  STORE_ADMIN // 旧后台门店管理员，保留兼容
  CONTENT_ADMIN // 内容管理员（旧模板角色）
  CUSTOMER_SERVICE // 客服（旧模板角色）
}

// 小程序用户身份：店长仍保留普通用户购买能力
enum UserRole {
  CUSTOMER // 普通用户
  STORE_MANAGER // 店长，可管理多家门店
}

// 优惠券类型
enum CouponType {
  CASH // 现金抵扣券
  EXCHANGE // 指定商品兑换券
}

// 优惠券适用商品范围
enum CouponScope {
  ALL // 全部商品
}

// 活动奖励触发条件
enum ActivityTrigger {
  NEW_USER // 新用户首次注册
  INVITATION // 成功邀请好友注册
}

// 优惠券发放来源
enum CouponSource {
  NEW_USER // 新人注册奖励
  INVITATION // 邀请奖励
  MANUAL // 后台手动发放
}

// 用户优惠券状态
enum CouponStatus {
  AVAILABLE // 可使用
  LOCKED // 被未支付订单占用
  USED // 已使用
  EXPIRED // 已过期
}

// 优惠券流水操作类型
enum CouponEventType {
  ISSUED // 发放
  LOCKED // 占用
  RELEASED // 释放占用
  USED // 使用
  RETURNED // 取消或退款返还
  EXPIRED // 过期
}

// 订单业务类型
enum OrderType {
  ORDINARY // 门店普通订单
  CUSTOM // 平台定制订单
}

// 订单履约方式
enum FulfillmentMethod {
  PICKUP // 到店自取
  DELIVERY // 配送到家
}

// 订单履约业务状态
enum OrderStatus {
  PENDING_PAYMENT // 待付款
  PENDING_ACCEPTANCE // 待门店接单
  ACCEPTED // 已接单，备货中
  READY // 已备货，待自取或配送
  PENDING_DISPATCH // 待平台派单
  DISPATCHED // 已人工派单
  DELIVERING // 配送中
  COMPLETED // 已完成
  CANCELLING // 取消处理中
  CANCELLED // 已取消
  CLOSED // 未支付已关闭
}

// 订单支付状态
enum PaymentStatus {
  PENDING // 待支付
  PAID // 已支付
  NOT_REQUIRED // 零元订单，无需支付
  REFUNDING // 退款中
  REFUNDED // 已退款
  REFUND_FAILED // 退款失败
  CLOSED // 未支付已关闭
}

// 单次微信支付记录状态
enum PaymentAttemptStatus {
  PENDING // 待支付
  SUCCEEDED // 支付成功
  FAILED // 支付失败
  CLOSED // 支付单已关闭
}

// 退款处理状态
enum RefundStatus {
  PENDING // 待发起退款
  PROCESSING // 退款处理中
  SUCCEEDED // 退款成功
  FAILED // 退款失败
}

// 库存变更类型
enum InventoryChangeType {
  INCREASE // 手动增加可售库存
  DECREASE // 手动减少可售库存
  STOCKTAKE // 盘点可售库存
  RESERVE // 下单预留库存
  RELEASE // 取消或超时释放预留
  CONSUME // 订单确认消耗预留
  RESTORE // 按实际情况恢复可售库存
}

/// 旧门店角色绑定 storeId；新店长使用 User 与 Store.managerId，不创建后台密码账号。
// 管理员表：保存后台账号、角色及绑定门店
model Admin {
  /// 主键 ID
  id              Int             @id @default(autoincrement())
  /// 后台登录用户名
  username        String          @unique @db.VarChar(64)
  /// 登录密码哈希
  password        String          @db.VarChar(255)
  /// 管理员显示名称
  displayName     String?         @map("display_name") @db.VarChar(64)
  /// 后台账号角色
  role            adminRole       @default(CUSTOMER_SERVICE)
  /// 关联门店 ID
  storeId         Int?            @map("store_id")
  /// 账号是否启用
  status          Boolean         @default(true)
  /// 最近登录时间
  lastLoginAt     DateTime?       @map("last_login_at") @db.DateTime(3)
  /// 创建时间
  createdAt       DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  /// 更新时间
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  /// 关联门店信息
  store           Store?          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  /// 关联库存变更流水列表
  inventoryLogs   InventoryLog[]
  /// 关联订单操作日志列表
  orderLogs       OrderLog[]
  /// 关联定制人工派单记录列表
  dispatches      OrderDispatch[]
  /// 关联退款记录列表
  refunds         Refund[]
  /// 关联该管理员完成的订单列表
  completedOrders Order[]         @relation("CompletedBy")
  @@index([storeId, status])
  @@map("admin")
}


// 门店表：保存门店信息、营业状态及配送服务配置
model Store {
  /// 主键 ID
  id              Int            @id @default(autoincrement())
  /// 业务编号
  code            String         @unique @db.VarChar(32)
  /// 名称
  name            String         @db.VarChar(100)
  /// 门店详细地址
  address         String         @db.VarChar(500)
  /// 联系电话
  phone           String         @db.VarChar(32)
  /// 营业时间说明
  businessHours   String         @map("business_hours") @db.VarChar(255)
  /// 是否启用
  enabled         Boolean        @default(true)
  /// 是否营业
  isOpen          Boolean        @default(true) @map("is_open")
  /// 配送服务区域说明
  deliveryArea    String?        @map("delivery_area") @db.Text
  /// 固定配送费（元）
  deliveryFee     Decimal        @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  /// 客服电话
  servicePhone    String?        @map("service_phone") @db.VarChar(32)
  /// 配送执行人员说明
  deliveryStaff   String?        @map("delivery_staff") @db.VarChar(255)
  /// 排序值，越小越靠前
  sortOrder       Int            @default(0) @map("sort_order")
  /// 店长用户 ID，同一用户可负责多家门店；允许历史门店暂未配置
  managerId       Int?           @map("manager_id")
  /// 关联店长用户，通过用户唯一手机号设置
  manager         User?          @relation("StoreManager", fields: [managerId], references: [id], onDelete: Restrict)
  /// 创建时间
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  /// 更新时间
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  /// 关联门店管理员列表
  admins          Admin[]
  /// 关联本店选品记录列表
  products        StoreProduct[]
  /// 关联归属本店的普通订单列表
  orders          Order[]        @relation("OrderStore")
  /// 关联本店实际履约订单列表
  fulfilledOrders Order[]        @relation("FulfilledStore")
  @@index([enabled, isOpen, sortOrder])
  @@index([managerId])
  @@map("store")
}

/// 固定 id=1，由业务层保证单例；定制服务不依赖门店。
// 平台配置表：保存定制服务及首页配置
model PlatformConfig {
  /// 平台配置主键，约定固定为 1
  id              Int      @id @default(1)
  /// 是否开放定制服务
  customEnabled   Boolean  @default(true) @map("custom_enabled")
  /// 配送服务区域说明
  deliveryArea    String?  @map("delivery_area") @db.Text
  /// 固定配送费（元）
  deliveryFee     Decimal  @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  /// 营业时间说明
  businessHours   String?  @map("business_hours") @db.VarChar(255)
  /// 客服电话
  servicePhone    String?  @map("service_phone") @db.VarChar(32)
  /// 配送执行人员说明
  deliveryStaff   String?  @map("delivery_staff") @db.VarChar(255)
  /// 首页展示内容配置
  homeContent     Json?    @map("home_content")
  /// 更新时间
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  @@map("platform_config")
}


// 商品分类表：保存鲜花品种分类及排序
model ProductCategory {
  /// 主键 ID
  id        Int       @id @default(autoincrement())
  /// 鲜花品种分类名称
  name      String    @unique @db.VarChar(64)
  /// 是否启用
  enabled   Boolean   @default(true)
  /// 排序值，越小越靠前
  sortOrder Int       @default(0) @map("sort_order")
  /// 关联商品列表
  products  Product[]
  @@map("product_category")
}

/// 商品按分类维护；已有业务记录的商品停用，不物理删除。
// 商品表：保存统一商品库的基础信息
model Product {
  /// 普通门店商品或平台成品花束，创建后不可切换。
  type          OrderType        @default(ORDINARY)
  /// 主键 ID
  id            Int              @id @default(autoincrement())
  /// 业务编号
  code          String           @unique @db.VarChar(64)
  /// 关联商品分类 ID
  categoryId    Int?             @map("category_id")
  /// 商品名称
  name          String           @db.VarChar(100)
  /// 商品封面图片地址
  coverImage    String           @map("cover_image") @db.VarChar(1024)
  /// 商品图片地址列表
  images        Json?
  /// 商品详细说明
  description   String?          @db.Text
  /// 商品是否启用或上架
  enabled       Boolean          @default(true)
  /// 排序值，越小越靠前
  sortOrder     Int              @default(0) @map("sort_order")
  /// 创建时间
  createdAt     DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  /// 更新时间
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  /// 关联商品分类
  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// 关联商品规格列表
  specs         ProductSpec[]
  /// 关联各门店选品记录列表
  storeProducts StoreProduct[]
  @@index([enabled, sortOrder])
  @@index([categoryId])
  @@map("product")
}

/// 统一规格与售价；stemsPerUnit 未配置为 null，不能将销售份数当支数。
// 商品规格表：保存规格、统一售价及每份支数
model ProductSpec {
  /// 主键 ID
  id                Int              @id @default(autoincrement())
  /// 关联商品 ID
  productId         Int              @map("product_id")
  /// 规格名称，如默认规格或8支
  name              String           @default("默认规格") @db.VarChar(100)
  /// 销售单位，如份或束
  unit              String           @default("份") @db.VarChar(20)
  /// 规格统一售价（元）
  price             Decimal          @db.Decimal(12, 2)
  /// 每销售单位包含的鲜花支数，未配置为空
  stemsPerUnit      Int?             @map("stems_per_unit")
  /// 是否启用
  enabled           Boolean          @default(true)
  /// 排序值，越小越靠前
  sortOrder         Int              @default(0) @map("sort_order")
  /// 创建时间
  createdAt         DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  /// 更新时间
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  /// 关联商品基础信息
  product           Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// 关联门店规格库存列表
  stocks            StoreStock[]
  /// 关联指定本规格兑换的券模板列表
  exchangeTemplates CouponTemplate[]
  /// 关联指定本规格兑换的用户优惠券列表
  exchangeCoupons   UserCoupon[]
  /// 关联订单规格明细列表
  orderItems        OrderItem[]
  @@unique([productId, name])
  @@unique([id, productId])
  @@map("product_spec")
}

/// 所有商品均可选品；上架至少支持一种履约方式。
// 门店选品表：保存门店上架商品及履约方式
model StoreProduct {
  /// 主键 ID
  id              Int          @id @default(autoincrement())
  /// 关联门店 ID
  storeId         Int          @map("store_id")
  /// 关联商品 ID
  productId       Int          @map("product_id")
  /// 本店商品是否上架
  enabled         Boolean      @default(false)
  /// 是否支持到店自取
  pickupEnabled   Boolean      @default(true) @map("pickup_enabled")
  /// 是否支持配送
  deliveryEnabled Boolean      @default(false) @map("delivery_enabled")
  /// 创建时间
  createdAt       DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  /// 更新时间
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  /// 关联门店信息
  store           Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  /// 关联商品基础信息
  product         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// 关联门店规格库存列表
  stocks          StoreStock[]
  @@unique([storeId, productId])
  @@unique([id, productId])
  @@index([productId])
  @@map("store_product")
}

/// 可售和预留库存按销售份数保存；复合外键确保选品与规格属于同一商品。
// 门店库存表：按商品规格保存可售及预留库存
model StoreStock {
  /// 主键 ID
  id             Int            @id @default(autoincrement())
  /// 关联门店选品 ID
  storeProductId Int            @map("store_product_id")
  /// 关联商品 ID
  productId      Int            @map("product_id")
  /// 关联商品规格 ID
  specId         Int            @map("spec_id")
  /// 当前可售库存（销售份数）
  available      Int            @default(0)
  /// 订单预留库存（销售份数）
  reserved       Int            @default(0)
  /// 乐观锁版本号，防止并发覆盖
  version        Int            @default(0)
  /// 更新时间
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  /// 关联门店选品信息
  storeProduct   StoreProduct   @relation(fields: [storeProductId, productId], references: [id, productId], onDelete: Restrict)
  /// 关联商品规格
  spec           ProductSpec    @relation(fields: [specId, productId], references: [id, productId], onDelete: Restrict)
  /// 关联操作日志列表
  logs           InventoryLog[]
  @@unique([storeProductId, specId])
  @@index([specId, productId])
  @@map("store_stock")
}


// 库存流水表：记录库存变更、原因及操作人
model InventoryLog {
  /// 主键 ID
  id              Int                 @id @default(autoincrement())
  /// 关联门店规格库存 ID
  stockId         Int                 @map("stock_id")
  /// 库存变更操作类型
  type            InventoryChangeType
  /// 变更前可售库存
  availableBefore Int                 @map("available_before")
  /// 变更后可售库存
  availableAfter  Int                 @map("available_after")
  /// 变更前预留库存
  reservedBefore  Int                 @map("reserved_before")
  /// 变更后预留库存
  reservedAfter   Int                 @map("reserved_after")
  /// 库存变更原因，系统操作也需记录
  reason          String              @db.VarChar(500)
  /// 关联操作管理员 ID
  adminId         Int?                @map("admin_id")
  /// 关联订单 ID
  orderId         Int?                @map("order_id")
  /// 操作幂等键，防止重复执行
  operationKey    String              @unique @map("operation_key") @db.VarChar(128)
  /// 创建时间
  createdAt       DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  /// 关联门店规格库存
  stock           StoreStock          @relation(fields: [stockId], references: [id], onDelete: Restrict)
  /// 关联操作管理员
  admin           Admin?              @relation(fields: [adminId], references: [id], onDelete: Restrict)
  /// 关联订单
  order           Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([stockId, createdAt])
  @@index([orderId])
  @@index([adminId])
  @@map("inventory_log")
}


// 用户表：保存微信身份、手机号及邀请码
model User {
  /// 主键 ID
  id           Int           @id @default(autoincrement())
  /// 微信小程序用户唯一标识，后台按手机号注册的店长首次授权前为空
  openId       String?       @unique @map("open_id") @db.VarChar(128)
  /// 微信开放平台用户统一标识
  unionId      String?       @unique @map("union_id") @db.VarChar(128)
  /// 用户唯一手机号，支持微信授权或平台设置店长时录入
  phone        String        @unique @db.VarChar(32)
  /// 用户身份，店长可关联多家门店并保留购物能力
  role         UserRole      @default(CUSTOMER)
  /// 该用户负责的门店列表
  managedStores Store[]      @relation("StoreManager")
  /// 用户昵称
  nickname     String?       @db.VarChar(64)
  /// 用户头像地址
  avatar       String?       @db.VarChar(1024)
  /// 用户邀请码
  inviteCode   String        @unique @map("invite_code") @db.VarChar(32)
  /// 是否启用
  enabled      Boolean       @default(true)
  /// 首次注册成功时间
  registeredAt DateTime      @default(now()) @map("registered_at") @db.DateTime(3)
  /// 最近登录时间
  lastLoginAt  DateTime?     @map("last_login_at") @db.DateTime(3)
  /// 更新时间
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  /// 关联用户收货地址列表
  addresses    UserAddress[]
  /// 关联用户优惠券列表
  coupons      UserCoupon[]
  /// 关联该用户下单记录列表
  orders       Order[]
  /// 关联该用户成功邀请记录列表
  invitations  Invitation[]  @relation("Inviter")
  /// 关联该用户被邀请的记录
  invitedBy    Invitation?   @relation("Invitee")
  @@map("user")
}


// 用户地址表：保存收货信息及默认地址
model UserAddress {
  /// 主键 ID
  id         Int      @id @default(autoincrement())
  /// 关联用户 ID
  userId     Int      @map("user_id")
  /// 收货人姓名
  name       String   @db.VarChar(64)
  /// 收货人手机号
  phone      String   @db.VarChar(32)
  /// 收货地址省份
  province   String   @db.VarChar(64)
  /// 收货地址城市
  city       String   @db.VarChar(64)
  /// 收货地址区县
  district   String   @db.VarChar(64)
  /// 收货地址行政区编码
  regionCode String?  @map("region_code") @db.VarChar(32)
  /// 收货详细地址
  detail     String   @db.VarChar(500)
  /// 是否为用户默认地址
  isDefault  Boolean  @default(false) @map("is_default")
  /// 创建时间
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  /// 更新时间
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  /// 关联用户信息
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, isDefault])
  @@map("user_address")
}

/// 新用户只能绑定一个邀请者；禁止自邀由业务层检查。
// 邀请关系表：保存邀请者与新注册用户的绑定关系
model Invitation {
  /// 主键 ID
  id         Int          @id @default(autoincrement())
  /// 关联邀请者用户 ID
  inviterId  Int          @map("inviter_id")
  /// 关联被邀请者用户 ID
  inviteeId  Int          @unique @map("invitee_id")
  /// 注册时绑定的邀请来源码
  inviteCode String       @map("invite_code") @db.VarChar(32)
  /// 创建时间
  createdAt  DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  /// 关联邀请者用户
  inviter    User         @relation("Inviter", fields: [inviterId], references: [id], onDelete: Restrict)
  /// 关联被邀请者用户
  invitee    User         @relation("Invitee", fields: [inviteeId], references: [id], onDelete: Restrict)
  /// 关联本次邀请发放的奖励券列表
  coupons    UserCoupon[]
  @@index([inviterId, createdAt])
  @@map("invitation")
}


// 优惠券模板表：保存现金抵扣或指定商品兑换规则
model CouponTemplate {
  /// 主键 ID
  id               Int                 @id @default(autoincrement())
  /// 优惠券模板名称
  name             String              @db.VarChar(100)
  /// 优惠券类型：现金抵扣或商品兑换
  type             CouponType
  /// 优惠券适用商品范围
  scope            CouponScope         @default(ALL)
  /// 现金券抵扣面额（元）
  cashAmount       Decimal?            @map("cash_amount") @db.Decimal(12, 2)
  /// 指定兑换的商品规格 ID
  exchangeSpecId   Int?                @map("exchange_spec_id")
  /// 优惠券兑换份数
  exchangeQuantity Int?                @map("exchange_quantity")
  /// 发放后有效时长（小时）
  validityHours    Int                 @default(120) @map("validity_hours")
  /// 是否启用
  enabled          Boolean             @default(true)
  /// 创建时间
  createdAt        DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  /// 更新时间
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  /// 关联指定兑换的商品规格
  exchangeSpec     ProductSpec?        @relation(fields: [exchangeSpecId], references: [id], onDelete: Restrict)
  /// 关联使用该模板的营销活动列表
  activities       MarketingActivity[]
  /// 关联用户优惠券列表
  coupons          UserCoupon[]
  @@index([exchangeSpecId])
  @@map("coupon_template")
}

/// 新人、邀请分别一条当前配置；改配置只影响新发券。
// 营销活动表：保存新人与邀请奖励配置及赠花成本规则
model MarketingActivity {
  /// 主键 ID
  id                   Int             @id @default(autoincrement())
  /// 奖励触发条件
  trigger              ActivityTrigger @unique
  /// 活动名称
  name                 String          @db.VarChar(100)
  /// 关联优惠券模板 ID
  templateId           Int             @map("template_id")
  /// 是否启用
  enabled              Boolean         @default(false)
  /// 是否计入活动赠花
  isFlowerGift         Boolean         @default(false) @map("is_flower_gift")
  /// 每份赠花报销单价（元），未配置为空
  reimbursementPerUnit Decimal?        @map("reimbursement_per_unit") @db.Decimal(12, 2)
  /// 创建时间
  createdAt            DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  /// 更新时间
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  /// 关联优惠券模板
  template             CouponTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// 关联该活动发放的用户优惠券列表
  coupons              UserCoupon[]
  @@index([templateId])
  @@map("marketing_activity")
}

/// 发放时复制模板/活动规则；历史快照不回写，过期以 expiresAt 为准。
// 用户优惠券表：保存已发券快照、有效期及使用状态
model UserCoupon {
  /// 主键 ID
  id                   Int                @id @default(autoincrement())
  /// 用户优惠券编号
  code                 String             @unique @db.VarChar(64)
  /// 关联用户 ID
  userId               Int                @map("user_id")
  /// 关联优惠券模板 ID
  templateId           Int                @map("template_id")
  /// 关联营销活动 ID
  activityId           Int?               @map("activity_id")
  /// 关联邀请记录 ID
  invitationId         Int?               @map("invitation_id")
  /// 优惠券发放来源
  source               CouponSource
  // 新人 new-user:{userId}；邀请 invite:{inviteeId}；不含模板版本，防重复发券。
  /// 发券幂等键，防止重复奖励
  grantKey             String             @unique @map("grant_key") @db.VarChar(128)
  /// 发放时优惠券名称快照
  name                 String             @db.VarChar(100)
  /// 发放时优惠券类型快照
  type                 CouponType
  /// 发放时适用商品范围快照
  scope                CouponScope
  /// 发放时现金券面额快照（元）
  cashAmount           Decimal?           @map("cash_amount") @db.Decimal(12, 2)
  /// 指定兑换的商品规格 ID
  exchangeSpecId       Int?               @map("exchange_spec_id")
  /// 发放时指定兑换份数快照
  exchangeQuantity     Int?               @map("exchange_quantity")
  /// 兑换商品名称快照
  exchangeProductName  String?            @map("exchange_product_name") @db.VarChar(100)
  /// 兑换规格名称快照
  exchangeSpecName     String?            @map("exchange_spec_name") @db.VarChar(100)
  /// 活动名称快照
  activityName         String?            @map("activity_name") @db.VarChar(100)
  /// 发放时是否计入赠花活动的快照
  isFlowerGift         Boolean            @default(false) @map("is_flower_gift")
  /// 发放时每份赠花报销单价快照（元）
  reimbursementPerUnit Decimal?           @map("reimbursement_per_unit") @db.Decimal(12, 2)
  /// 优惠券可用、占用、使用或过期状态
  status               CouponStatus       @default(AVAILABLE)
  // 当前占用/使用指针，释放或返券时清空；历史订单关联不清空。
  /// 当前占用或使用订单 ID，释放或返还时清空
  currentOrderId       Int?               @unique @map("current_order_id")
  /// 优惠券发放时间
  issuedAt             DateTime           @default(now()) @map("issued_at") @db.DateTime(3)
  /// 优惠券失效时间，返券默认不延长
  expiresAt            DateTime           @map("expires_at") @db.DateTime(3)
  /// 最近一次使用时间
  usedAt               DateTime?          @map("used_at") @db.DateTime(3)
  /// 更新时间
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  /// 关联用户信息
  user                 User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// 关联优惠券模板
  template             CouponTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// 关联营销活动
  activity             MarketingActivity? @relation(fields: [activityId], references: [id], onDelete: Restrict)
  /// 关联奖励来源邀请记录
  invitation           Invitation?        @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  /// 关联指定兑换的商品规格
  exchangeSpec         ProductSpec?       @relation(fields: [exchangeSpecId], references: [id], onDelete: Restrict)
  /// 关联当前占用或使用的订单
  currentOrder         Order?             @relation("CurrentCouponOrder", fields: [currentOrderId], references: [id], onDelete: Restrict)
  /// 关联曾使用本券的历史订单列表
  orders               Order[]            @relation("OrderCoupon")
  /// 关联优惠券操作流水列表
  events               CouponEvent[]
  @@index([userId, status, expiresAt])
  @@index([templateId])
  @@index([activityId])
  @@index([invitationId])
  @@index([exchangeSpecId])
  @@map("user_coupon")
}


// 优惠券流水表：记录发放、占用、使用及返还历史
model CouponEvent {
  /// 主键 ID
  id           Int             @id @default(autoincrement())
  /// 关联用户优惠券 ID
  couponId     Int             @map("coupon_id")
  /// 关联订单 ID
  orderId      Int?            @map("order_id")
  /// 优惠券操作流水类型
  type         CouponEventType
  /// 操作幂等键，防止重复执行
  operationKey String          @unique @map("operation_key") @db.VarChar(128)
  /// 备注说明
  remark       String?         @db.VarChar(500)
  /// 创建时间
  createdAt    DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  /// 关联用户优惠券
  coupon       UserCoupon      @relation(fields: [couponId], references: [id], onDelete: Restrict)
  /// 关联订单
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([couponId, createdAt])
  @@index([orderId])
  @@map("coupon_event")
}

/// 普通订单必须归属门店；定制无门店且仅配送。两类业务按 type 强制隔离。
// 订单表：保存订单归属、金额、支付及履约状态
model Order {
  /// 主键 ID
  id               Int               @id @default(autoincrement())
  /// 业务订单号
  orderNo          String            @unique @map("order_no") @db.VarChar(64)
  /// 关联用户 ID
  userId           Int               @map("user_id")
  /// 用户提交订单幂等键
  requestKey       String            @map("request_key") @db.VarChar(64)
  /// 普通门店订单或平台定制订单
  type             OrderType
  /// 归属门店 ID，定制订单为空
  storeId          Int?              @map("store_id")
  /// 自取或配送履约方式
  method           FulfillmentMethod
  /// 订单履约业务状态
  status           OrderStatus       @default(PENDING_PAYMENT)
  /// 订单支付状态
  paymentStatus    PaymentStatus     @default(PENDING) @map("payment_status")
  /// 乐观锁版本号，防止并发覆盖
  version          Int               @default(0)
  /// 订单联系人姓名
  contactName      String            @map("contact_name") @db.VarChar(64)
  /// 订单联系人手机号
  contactPhone     String            @map("contact_phone") @db.VarChar(32)
  /// 下单时收货地址快照
  addressSnapshot  Json?             @map("address_snapshot")
  /// 下单时门店信息快照
  storeSnapshot    Json?             @map("store_snapshot")
  /// 下单时服务区域、费用及客服配置快照
  serviceSnapshot  Json              @map("service_snapshot")
  /// 备注说明
  remark           String?           @db.VarChar(500)
  /// 商品原价总金额（元）
  productAmount    Decimal           @map("product_amount") @db.Decimal(12, 2)
  /// 优惠抵扣金额（元）
  discountAmount   Decimal           @default(0) @map("discount_amount") @db.Decimal(12, 2)
  /// 固定配送费（元）
  deliveryFee      Decimal           @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  /// 订单应付金额，含配送费（元）
  payableAmount    Decimal           @map("payable_amount") @db.Decimal(12, 2)
  /// 关联用户优惠券 ID
  couponId         Int?              @map("coupon_id")
  /// 下单时优惠券规则快照
  couponSnapshot   Json?             @map("coupon_snapshot")
  /// 到店自取核销码
  pickupCode       String?           @map("pickup_code") @db.VarChar(16)
  /// 未支付订单自动关闭截止时间
  expiresAt        DateTime          @map("expires_at") @db.DateTime(3)
  /// 支付成功或零元订单确认时间
  confirmedAt      DateTime?         @map("confirmed_at") @db.DateTime(3)
  /// 门店接单时间
  acceptedAt       DateTime?         @map("accepted_at") @db.DateTime(3)
  /// 门店备货完成时间
  readyAt          DateTime?         @map("ready_at") @db.DateTime(3)
  /// 平台确认人工派单时间
  dispatchedAt     DateTime?         @map("dispatched_at") @db.DateTime(3)
  /// 开始配送时间
  deliveringAt     DateTime?         @map("delivering_at") @db.DateTime(3)
  /// 订单实际完成时间
  completedAt      DateTime?         @map("completed_at") @db.DateTime(3)
  /// 关联完成操作管理员 ID
  completedById    Int?              @map("completed_by_id")
  /// 实际履约门店 ID，用于赠花归属统计
  fulfilledStoreId Int?              @map("fulfilled_store_id")
  /// 取消完成时间
  cancelledAt      DateTime?         @map("cancelled_at") @db.DateTime(3)
  /// 未支付订单关闭时间
  closedAt         DateTime?         @map("closed_at") @db.DateTime(3)
  /// 订单取消原因
  cancelReason     String?           @map("cancel_reason") @db.VarChar(500)
  /// 创建时间
  createdAt        DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  /// 更新时间
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  /// 关联用户信息
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// 关联门店信息
  store            Store?            @relation("OrderStore", fields: [storeId], references: [id], onDelete: Restrict)
  /// 关联实际履约门店
  fulfilledStore   Store?            @relation("FulfilledStore", fields: [fulfilledStoreId], references: [id], onDelete: Restrict)
  /// 关联完成订单的管理员
  completedBy      Admin?            @relation("CompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  /// 关联用户优惠券
  coupon           UserCoupon?       @relation("OrderCoupon", fields: [couponId], references: [id], onDelete: Restrict)
  /// 关联当前占用本订单的优惠券
  currentCoupon    UserCoupon?       @relation("CurrentCouponOrder")
  /// 关联唯一商品规格明细
  item             OrderItem?
  /// 关联微信支付尝试列表
  payments         Payment[]
  /// 关联整单退款记录
  refund           Refund?
  /// 关联订单状态操作日志列表
  logs             OrderLog[]
  /// 关联定制人工派单记录列表
  dispatches       OrderDispatch[]
  /// 关联库存变更流水列表
  inventoryLogs    InventoryLog[]
  /// 关联优惠券操作流水列表
  couponEvents     CouponEvent[]
  @@unique([userId, requestKey])
  @@index([userId, createdAt])
  @@index([storeId, type, status, createdAt])
  @@index([type, status, createdAt])
  @@index([type, completedAt])
  @@index([fulfilledStoreId, completedAt])
  @@index([status, expiresAt])
  @@index([couponId])
  @@index([completedById])
  @@map("order")
}

/// orderId 唯一：首期每单只买一个规格；订单与明细须在同一事务内创建。
// 订单明细表：保存购买规格及价格、赠花成本快照
model OrderItem {
  /// 主键 ID
  id                   Int         @id @default(autoincrement())
  /// 关联订单 ID
  orderId              Int         @unique @map("order_id")
  /// 关联商品规格 ID
  specId               Int         @map("spec_id")
  /// 商品名称快照
  productName          String      @map("product_name") @db.VarChar(100)
  /// 商品分类名称快照
  categoryName         String?     @map("category_name") @db.VarChar(64)
  /// 下单时商品封面图片地址快照
  coverImage           String      @map("cover_image") @db.VarChar(1024)
  /// 商品规格名称快照
  specName             String      @map("spec_name") @db.VarChar(100)
  /// 下单时销售单位快照
  unit                 String      @db.VarChar(20)
  /// 下单时规格单价（元）
  unitPrice            Decimal     @map("unit_price") @db.Decimal(12, 2)
  /// 购买数量（销售份数）
  quantity             Int
  /// 下单时每份鲜花支数快照
  stemsPerUnit         Int?        @map("stems_per_unit")
  /// 商品原价总金额（元）
  productAmount        Decimal     @map("product_amount") @db.Decimal(12, 2)
  /// 优惠抵扣金额（元）
  discountAmount       Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  /// 本单通过兑换券兑换的销售份数
  exchangeQuantity     Int         @default(0) @map("exchange_quantity")
  /// 指定赠花活动免费兑换份数
  giftQuantity         Int         @default(0) @map("gift_quantity")
  /// 实际活动赠花支数，支数未知时为空
  giftStems            Int?        @map("gift_stems")
  /// 下单时每份赠花报销单价快照（元）
  reimbursementPerUnit Decimal?    @map("reimbursement_per_unit") @db.Decimal(12, 2)
  /// 活动赠花应报销金额（元），单价未知时为空
  reimbursementAmount  Decimal?    @map("reimbursement_amount") @db.Decimal(12, 2)
  /// 关联订单
  order                Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// 关联商品规格
  spec                 ProductSpec @relation(fields: [specId], references: [id], onDelete: Restrict)
  @@index([specId])
  @@map("order_item")
}

/// 允许多次支付尝试，微信交易号唯一；0元确认无需支付记录。
// 支付记录表：保存微信支付尝试及交易结果
model Payment {
  /// 主键 ID
  id            Int                  @id @default(autoincrement())
  /// 关联订单 ID
  orderId       Int                  @map("order_id")
  /// 微信支付商户订单号
  outTradeNo    String               @unique @map("out_trade_no") @db.VarChar(64)
  /// 微信支付交易号
  transactionId String?              @unique @map("transaction_id") @db.VarChar(64)
  /// 微信预支付会话标识
  prepayId      String?              @map("prepay_id") @db.VarChar(128)
  /// 本次微信支付金额（元）
  amount        Decimal              @db.Decimal(12, 2)
  /// 本次支付尝试状态
  status        PaymentAttemptStatus @default(PENDING)
  /// 微信确认支付成功时间
  paidAt        DateTime?            @map("paid_at") @db.DateTime(3)
  /// 本次微信支付单失效时间
  expiresAt     DateTime             @map("expires_at") @db.DateTime(3)
  /// 失败原因
  failureReason String?              @map("failure_reason") @db.VarChar(500)
  /// 创建时间
  createdAt     DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  /// 更新时间
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  /// 关联订单
  order         Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// 关联退款记录列表
  refunds       Refund[]
  @@index([orderId, status])
  @@index([status, expiresAt])
  @@map("payment")
}

/// 整单退款一条逻辑记录，失败使用相同 outRefundNo 重试；0元取消不调微信。
// 退款记录表：保存整单退款及重试、返券结果
model Refund {
  /// 主键 ID
  id               Int          @id @default(autoincrement())
  /// 关联订单 ID
  orderId          Int          @unique @map("order_id")
  /// 关联支付记录 ID
  paymentId        Int          @map("payment_id")
  /// 商户退款单号
  outRefundNo      String       @unique @map("out_refund_no") @db.VarChar(64)
  /// 微信退款单号
  wechatRefundId   String?      @unique @map("wechat_refund_id") @db.VarChar(64)
  /// 整单申请退款金额（元）
  amount           Decimal      @db.Decimal(12, 2)
  /// 申请整单退款原因
  reason           String       @db.VarChar(500)
  /// 退款处理状态
  status           RefundStatus @default(PENDING)
  /// 关联操作管理员 ID
  adminId          Int          @map("admin_id")
  /// 失败原因
  failureReason    String?      @map("failure_reason") @db.VarChar(500)
  /// 退款重试次数
  retryCount       Int          @default(0) @map("retry_count")
  /// 退款成功时间
  succeededAt      DateTime?    @map("succeeded_at") @db.DateTime(3)
  /// 退款后优惠券返还完成时间
  couponReturnedAt DateTime?    @map("coupon_returned_at") @db.DateTime(3)
  /// 创建时间
  createdAt        DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  /// 更新时间
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  /// 关联订单
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// 关联微信支付记录
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  /// 关联操作管理员
  admin            Admin        @relation(fields: [adminId], references: [id], onDelete: Restrict)
  @@index([status, createdAt])
  @@index([paymentId])
  @@index([adminId])
  @@map("refund")
}

/// 人工派单保留历次记录；合作方不绑定门店账号。
// 定制派单表：记录人工派单的合作方及操作人
model OrderDispatch {
  /// 主键 ID
  id           Int      @id @default(autoincrement())
  /// 关联订单 ID
  orderId      Int      @map("order_id")
  /// 承接制作配送的合作方名称
  partnerName  String   @map("partner_name") @db.VarChar(100)
  /// 合作方联系电话
  partnerPhone String   @map("partner_phone") @db.VarChar(32)
  /// 人工派单说明
  remark       String?  @db.VarChar(500)
  /// 关联操作管理员 ID
  adminId      Int      @map("admin_id")
  /// 操作幂等键，防止重复执行
  operationKey String   @unique @map("operation_key") @db.VarChar(128)
  /// 创建时间
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  /// 关联订单
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// 关联操作管理员
  admin        Admin    @relation(fields: [adminId], references: [id], onDelete: Restrict)
  @@index([orderId, createdAt])
  @@index([adminId])
  @@map("order_dispatch")
}


// 订单操作日志表：记录操作身份及订单状态变化
model OrderLog {
  /// 主键 ID
  id                Int            @id @default(autoincrement())
  /// 关联订单 ID
  orderId           Int            @map("order_id")
  /// 关联操作管理员 ID
  adminId           Int?           @map("admin_id")
  /// 操作者类型：用户、管理员或系统
  actorType         String         @map("actor_type") @db.VarChar(20)
  /// 操作者 ID，系统操作时可为空
  actorId           Int?           @map("actor_id")
  /// 执行的业务操作
  action            String         @db.VarChar(64)
  /// 变更前订单履约状态
  fromStatus        OrderStatus?   @map("from_status")
  /// 变更后订单履约状态
  toStatus          OrderStatus    @map("to_status")
  /// 变更前订单支付状态
  fromPaymentStatus PaymentStatus? @map("from_payment_status")
  /// 变更后订单支付状态
  toPaymentStatus   PaymentStatus  @map("to_payment_status")
  /// 操作幂等键，防止重复执行
  operationKey      String         @unique @map("operation_key") @db.VarChar(128)
  /// 备注说明
  remark            String?        @db.VarChar(500)
  /// 创建时间
  createdAt         DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  /// 关联订单
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// 关联操作管理员
  admin             Admin?         @relation(fields: [adminId], references: [id], onDelete: Restrict)
  @@index([orderId, createdAt])
  @@index([adminId])
  @@map("order_log")
}
