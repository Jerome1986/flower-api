# 合并到现有 .env，保留数据库和登录等其他配置；不要复制 jel 的回调域名。
# 与 jel 一致的支付基础配置。
APPID=
MCH_ID=
SERIALNO=
API_V3_KEY=
# 下单端点固定为直连商户 JSAPI。
PAY_URL=https://api.mch.weixin.qq.com/v3/pay/transactions/jsapi
# 微信支付验签公钥及公钥 ID（不是商户证书序列号）。PEM 换行可写为 \n。
WECHATPAY_PUBLIC_KEY_ID=
WECHATPAY_PUBLIC_KEY=
# 商户私钥只在 src/utils/wechat-pay.ts 的 getPrivateKey() 本地填写。
# 支付和退款地址分开校验；必须指向当前鲜花项目，不可使用旧项目回调。
NOTIFY_URL=
REFUND_NOTIFY_URL=
